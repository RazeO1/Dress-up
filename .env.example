# Supabase project URL (e.g. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Supabase anon key (safe to expose to the client)
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Supabase service role key (NEVER expose to the client; server-only)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Database connection strings
# - Production / dev: Supabase "Direct connection" string
# - Test: a separate database (e.g. local Postgres or a second Supabase branch)
DATABASE_URL="postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres"
DATABASE_URL_TEST="postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres_test"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"
